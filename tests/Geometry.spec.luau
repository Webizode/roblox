local harness = require("./harness")
local describe, it, expect = harness.describe, harness.it, harness.expect

local TowerShape = require("../src/shared/TowerShape")
local ShotMath = require("../src/shared/ShotMath")
local TowerTuning = require("../src/shared/Config/Tower")
local LauncherTuning = require("../src/shared/Config/Launcher")

describe("TowerShape", function()
	it("stacks scoops straight up when upright", function()
		for index = 1, 10 do
			local ox, oy, oz = TowerShape.offset(index, 10, 0, 0, TowerTuning)
			expect(ox).toBe(0)
			expect(oz).toBe(0)
			expect(oy).toBeCloseTo(TowerTuning.coneHeight + (index - 0.5) * TowerTuning.scoopSpacing)
		end
	end)

	it("bends towards the tilt, more at the top than at the bottom", function()
		local bottomX = TowerShape.offset(1, 20, 0.3, 0, TowerTuning)
		local middleX = TowerShape.offset(10, 20, 0.3, 0, TowerTuning)
		local topX = TowerShape.offset(20, 20, 0.3, 0, TowerTuning)
		expect(bottomX).toBeGreaterThan(0)
		expect(middleX).toBeGreaterThan(bottomX)
		expect(topX).toBeGreaterThan(middleX)
		local _, _, negativeZ = TowerShape.offset(20, 20, 0, -0.3, TowerTuning)
		expect(negativeZ).toBeLessThan(0)
	end)

	it("puts the free slot just above the top scoop", function()
		local _, topY = TowerShape.offset(12, 12, 0, 0, TowerTuning)
		local _, slotY = TowerShape.top(12, 0, 0, TowerTuning)
		expect(slotY - topY).toBeCloseTo(TowerTuning.scoopSpacing)
		local _, emptySlotY = TowerShape.top(0, 0, 0, TowerTuning)
		expect(emptySlotY).toBeCloseTo(TowerTuning.coneHeight + 0.5 * TowerTuning.scoopSpacing)
	end)
end)

describe("ShotMath", function()
	it("starts at the nozzle and lands on the target", function()
		local x0, y0, z0 = ShotMath.position(0, 30, 0, 40, 1, -20, 18, 0)
		expect(x0).toBe(0)
		expect(y0).toBe(30)
		expect(z0).toBe(0)
		local x1, y1, z1 = ShotMath.position(0, 30, 0, 40, 1, -20, 18, 1)
		expect(x1).toBe(40)
		expect(y1).toBe(1)
		expect(z1).toBe(-20)
	end)

	it("arcs above the straight line and clamps alpha", function()
		local _, mid = ShotMath.position(0, 10, 0, 10, 10, 0, 6, 0.5)
		expect(mid).toBeCloseTo(16)
		local _, past = ShotMath.position(0, 10, 0, 10, 2, 0, 6, 1.4)
		expect(past).toBe(2)
	end)

	it("gives longer, higher flights for longer distances", function()
		expect(ShotMath.flightTime(80, LauncherTuning)).toBeGreaterThan(ShotMath.flightTime(10, LauncherTuning))
		expect(ShotMath.apex(80, LauncherTuning)).toBeGreaterThan(ShotMath.apex(10, LauncherTuning))
	end)
end)
