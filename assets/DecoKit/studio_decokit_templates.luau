--!nocheck
-- Turns imported deco kit models into templates (Edit mode, command bar or Studio MCP): every Model in Workspace named
-- DecoKit_<Model> (as the 3D importer names DecoKit_<Model>.fbx from assets/DecoKit/fbx, assets/DecoKit/README.md).
--   * each MeshPart <Model>_<Colour> (and <Model>_<Part>_<Colour>) gets its game colour, the attribute Colour,
--     SmoothPlastic, Anchored, and neither collides nor takes queries or touches. Lamp glass is Neon with a
--     PointLight, Water and Glass are see-through. Signpost arrows (_Arrow) get the attribute TextFace = "Front" and a SurfaceGui Sign with
--     their word (SIGNS).
--   * the model gets the simple collision of COLLISION: invisible Parts `Collision` (the first, the PrimaryPart) and
--     `Collision_<Name>`; benches and stools get invisible Seats (SEATS). The pivot stays at the bottom centre.
--   * the import moves to ServerStorage.DecoKit.<Model>; VARIANTS add recoloured copies <Model>_<Variant> (a template
--     there is replaced). Safe to repeat after a fresh import.
-- GENERATED by assets/DecoKit/build_hub_pack.py from decokit_models.json: change the Blender build, not this file.
-- Coordinates are Roblox studs in the model's frame (x right, y up, the front at -Z), from the pivot.

local GAME_COLOURS = {
	Caramel = "#C98A4F",
	Cherry = "#E8384F",
	Choco = "#7A4528",
	Cream = "#FFE9D0",
	Glass = "#75D6F2",
	Gold = "#F2A83C",
	Lamp = "#FFD66E",
	Lavender = "#BB9CF0",
	Leaf = "#86C94B",
	LeafDark = "#55A13C",
	Mint = "#7FE0B8",
	Pink = "#F06AAE",
	Rock = "#A99CC0",
	SkyBlue = "#75D6F2",
	Stone = "#E2A4B4",
	Waffle = "#E2782C",
	Water = "#86DDF7",
	Wood = "#C9783C",
}
local GLASS_TRANSPARENCY = 0.55
local WATER_TRANSPARENCY = 0.35
local LIGHT = { colour = Color3.fromRGB(255, 214, 140), brightness = 2, range = 18, enabled = false }

-- per model: boxes { size = Vector3, centre } or upright cylinders { size = (height, diameter, diameter) }
local COLLISION = {
	BushFlower = {
	},
	BushRound = {
	},
	BushSmall = {
	},
	Hedge = {
	},
	IceTreeUpright = {
		{ kind = "box", name = "Trunk", size = Vector3.new(2.32, 8.7, 2.32), centre = Vector3.new(0, 4.35, 0) },
	},
	Leaderboard = {
		{ kind = "box", name = "Sign", size = Vector3.new(11.2, 11.7, 1.4), centre = Vector3.new(0, 5.85, 0) },
	},
	LollipopTree = {
		{ kind = "box", name = "Trunk", size = Vector3.new(0.72, 7.6, 0.72), centre = Vector3.new(0, 3.8, 0) },
	},
	PalmBent = {
		{ kind = "box", name = "Trunk", size = Vector3.new(1.7, 6.2, 1.7), centre = Vector3.new(-0.25, 3.1, 0) },
	},
	PalmStraight = {
		{ kind = "box", name = "Trunk", size = Vector3.new(1.7, 6.2, 1.7), centre = Vector3.new(0, 3.1, 0) },
	},
	RockFlat = {
	},
	RockGroup = {
	},
	RockRound = {
	},
	TreeRound = {
		{ kind = "box", name = "Trunk", size = Vector3.new(1.52, 7.2, 1.52), centre = Vector3.new(0, 3.6, 0) },
	},
	TreeTall = {
		{ kind = "box", name = "Trunk", size = Vector3.new(0.96, 3.2, 0.96), centre = Vector3.new(0, 1.6, 0) },
	},
}
-- seats: where the seat's top is and the point it looks at
local SEATS = {
}
-- words on parts _Arrow<n>_: the field is left, right, top, bottom as fractions of the part's Front face
local SIGNS = {
}
-- recoloured copies: variant = { part = colour }
local VARIANTS = {
	IceTreeUpright = { Lemon = { Crown = "Gold", Crown2 = "Pink" }, Mint = { Crown = "Mint", Crown2 = "Cream" } },
}

local SS = game:GetService("ServerStorage")
local folder = SS:FindFirstChild("DecoKit") or Instance.new("Folder")
folder.Name = "DecoKit"
folder.Parent = SS

local function invisible(name, cframe, size, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cframe
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- a cylinder's axis (X) pointing up

-- a SurfaceGui "Sign" on the part's Front face with one word in the field (fractions of the face)
local function makeSign(part, area, word)
	local old = part:FindFirstChild("Sign")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	local label = Instance.new("TextLabel")
	label.Name = "Word"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(area[1], area[3])
	label.Size = UDim2.fromScale(area[2] - area[1], area[4] - area[3])
	label.Font = Enum.Font.FredokaOne
	label.Text = word
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromHex(GAME_COLOURS.Choco)
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
end

local function recolour(model, partName, colour)
	for _, part in model:GetDescendants() do
		if part:IsA("MeshPart") and part.Name:find("_" .. partName .. "_", 1, true) then
			part.Color = Color3.fromHex(GAME_COLOURS[colour])
			part:SetAttribute("Colour", colour)
		end
	end
end

local report = {}
for _, model in workspace:GetChildren() do
	if not (model:IsA("Model") and model.Name:sub(1, 8) == "DecoKit_") then
		continue
	end
	local name = model.Name:sub(9)
	local pivot = model:GetPivot()
	local coloured, lights, signs, unknown = 0, 0, 0, {}
	for _, part in model:GetDescendants() do
		if part:IsA("MeshPart") then
			local colour = part.Name:match("_(%a+)$")
			local hex = colour and GAME_COLOURS[colour]
			if hex then
				part.Color = Color3.fromHex(hex)
				part:SetAttribute("Colour", colour)
				coloured += 1
			else
				table.insert(unknown, part.Name)
			end
			part.Material = if colour == "Lamp" then Enum.Material.Neon else Enum.Material.SmoothPlastic
			part.Transparency = if colour == "Water"
				then WATER_TRANSPARENCY
				elseif colour == "Glass" then GLASS_TRANSPARENCY
				else 0
			part.CastShadow = colour ~= "Lamp" and colour ~= "Water"
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			if colour == "Lamp" and not part:FindFirstChildOfClass("PointLight") then
				local light = Instance.new("PointLight")
				light.Color = LIGHT.colour
				light.Brightness = LIGHT.brightness
				light.Range = LIGHT.range
				light.Enabled = LIGHT.enabled
				light.Shadows = false
				light.Parent = part
				lights += 1
			end
			if part.Name:find("_Arrow", 1, true) then
				part:SetAttribute("TextFace", "Front")
				local index = tonumber(part.Name:match("_Arrow(%d+)_"))
				local sign = SIGNS[name]
				if sign and index and sign.labels[index] then
					makeSign(part, sign.area, sign.labels[index])
					signs += 1
				end
			end
		end
	end
	for _, old in model:GetChildren() do
		if old:IsA("BasePart") and (old.Name:sub(1, 9) == "Collision" or old:IsA("Seat")) then
			old:Destroy()
		end
	end
	local primary
	for i, spec in COLLISION[name] or {} do
		local at = pivot * CFrame.new(spec.centre)
		local part
		if spec.kind == "cylinder" then
			part = invisible("Collision", at * UP, spec.size, Enum.PartType.Cylinder)
		else
			part = invisible("Collision", at, spec.size)
		end
		if i > 1 then
			part.Name = "Collision_" .. (spec.name or tostring(i))
		end
		part.Parent = model
		primary = primary or part
	end
	for i, s in SEATS[name] or {} do
		local seat = Instance.new("Seat")
		seat.Name = "Seat" .. i
		seat.Size = Vector3.new(2, 0.2, 2)
		local at = (pivot * CFrame.new(s.at)).Position
		local look = (pivot * CFrame.new(s.look)).Position
		seat.CFrame = CFrame.lookAt(at, look) * CFrame.new(0, -0.1, 0)
		seat.Transparency = 1
		seat.Anchored = true
		seat.CanCollide = false
		seat.CanQuery = false
		seat.CanTouch = true
		seat.Parent = model
	end
	if primary then
		model.PrimaryPart = primary
		primary.PivotOffset = primary.CFrame:ToObjectSpace(pivot)
	else
		model.WorldPivot = pivot
	end
	local old = folder:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	model:PivotTo(CFrame.new()) -- the template stands at the origin, upright, its front to -Z
	model.Name = name
	model.Parent = folder
	local variants = {}
	for variant, parts in VARIANTS[name] or {} do
		local copyName = name .. "_" .. variant
		local previous = folder:FindFirstChild(copyName)
		if previous then
			previous:Destroy()
		end
		local copy = model:Clone()
		copy.Name = copyName
		for partName, colour in parts do
			recolour(copy, partName, colour)
		end
		copy.Parent = folder
		table.insert(variants, copyName)
	end
	table.insert(
		report,
		`{name}: {coloured} meshes coloured{#unknown > 0 and " (no colour: " .. table.concat(unknown, ", ") .. ")" or ""}, {#(COLLISION[name] or {})} collision parts, {#(SEATS[name] or {})} seats, {lights} lights, {signs} signs{#variants > 0 and ", variants " .. table.concat(variants, ", ") or ""}`
	)
end

-- invisible text faces: Display (the board) and Header (the plank), Front facing the model's front
local FACES = {
	Leaderboard = {
		{ name = "Display", size = Vector3.new(8.3, 6.7, 0.05), centre = Vector3.new(0, 6.6, -0.62) },
		{ name = "Header", size = Vector3.new(8.8, 1.2, 0.05), centre = Vector3.new(0, 11.35, -0.73) },
	},
}
for name, faces in FACES do
	local model = folder:FindFirstChild(name)
	if model then
		for _, spec in faces do
			local old = model:FindFirstChild(spec.name)
			if old then
				old:Destroy()
			end
			local p = Instance.new("Part")
			p.Name = spec.name
			p.Size = spec.size
			p.CFrame = model:GetPivot() * CFrame.new(spec.centre)
			p.Transparency = 1
			p.Anchored = true
			p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
			p.CastShadow = false
			p:SetAttribute("TextFace", "Front")
			p.Parent = model
		end
	end
end
return #report > 0 and table.concat(report, "\n") or "no DecoKit_* model in Workspace"
