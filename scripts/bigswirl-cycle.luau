-- lune run scripts/bigswirl-cycle
-- Turns the Big Swirl's arm cycle, animated and baked in Blender (assets/BigSwirl/arm_cycle.json, written by
-- assets/BigSwirl/animate_bigswirl.py), into src/shared/Config/BigSwirlCycle.luau: the shoulder and wrist angle of
-- every frame. The game turns each arm's bones by these itself (BigSwirlArms), so no animation asset is needed and
-- arms moving at the same time never blend into each other.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local INPUT = "assets/BigSwirl/arm_cycle.json"
local OUTPUT = "src/shared/Config/BigSwirlCycle.luau"

local cycle = serde.decode("json", fs.readFile(INPUT))

local function list(key: string): string
	local values = {}
	for _, frame in cycle.frames do
		table.insert(values, string.format("%.2f", frame[key]))
	end
	-- one value per line, the way StyLua lays out a long table
	return "\t\t" .. table.concat(values, ",\n\t\t") .. ","
end

local source = table.concat({
	"--!strict",
	"-- GENERATED by scripts/bigswirl-cycle.luau from assets/BigSwirl/arm_cycle.json; do not edit by hand.",
	"-- The Big Swirl arm cycle as baked in Blender: per frame, in degrees from the rest pose, the shoulder's lift",
	"-- (positive = up) and the wrist's tip (positive = the cup's opening tips outward). BigSwirlArms turns the bones",
	"-- ArmN (shoulder) and ArmN_Cup (wrist) by them.",
	"",
	"return {",
	`\tfps = {cycle.fps},`,
	"\tshoulder = {",
	list("shoulder"),
	"\t},",
	"\twrist = {",
	list("wrist"),
	"\t},",
	"}",
	"",
}, "\n")

fs.writeFile(OUTPUT, source)
print(`wrote {OUTPUT}: {#cycle.frames} frames at {cycle.fps} fps`)
